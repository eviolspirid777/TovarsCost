<Window x:Class="CheckAmmount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckAmmount"
        mc:Ignorable="d"
        Title="Расчет комбинаций" Height="450" Width="800">
    <Grid Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Menu>
                <MenuItem Header="Файл">
                    <MenuItem Header="Открыть" Click="OpenFileClick"></MenuItem>
                    <MenuItem x:Name="SaveFileMenuItem" Header="Сохранить" Click="SaveFileClick" IsEnabled="False"></MenuItem>
                </MenuItem>
                <MenuItem Header="База данных">
                    <MenuItem Header="Открыть соединение" Click="OpenBdConnectionWindow"></MenuItem>
                </MenuItem>
            </Menu>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ValuesTable" AutoGenerateColumns="True" Margin="10"/>
            <GridSplitter VerticalAlignment="Stretch" Width="3px" Background="Gray" Grid.Column="1"/>
            <Grid Grid.Column="1">
                <Grid Margin="0 0 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*"></RowDefinition>
                        <RowDefinition Height="2*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Name="CombinationCountLabel"
                           FontSize="10"
                           Height="22"
                           Content="Число найденных комбинаций: 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Row="0"
                        />
                    <ListBox x:Name="CombinationsList" Margin="0, 30, 0, 0" Grid.Row="0" KeyDown="CombinationsList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Count}" />
                                    <TextBlock Text="{Binding Cost, StringFormat='{}{0:C}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <GroupBox x:Name="ammount" Header="Стоимость в чеке" Height="47">
                            <TextBox x:Name="ammountTextBox"/>
                        </GroupBox>
                        <Button x:Name="SubmitButton" Grid.Row="1" Height="26" Click="CombinationClick" FontSize="14">Рассчитать</Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>